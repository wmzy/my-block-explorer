{
  "name": "my-block-explorer",
  "version": "1.3.0",
  "type": "module",
  "description": "Multi-chain blockchain explorer with auto-discovery",
  "bin": {
    "my-block-explorer": "./dist/server/cli.js",
    "my-block-explorer-mcp": "./dist/server/mcp.js"
  },
  "files": [
    "dist/server",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/server/server.js",
  "exports": {
    ".": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmzy/my-block-explorer.git"
  },
  "keywords": [
    "blockchain",
    "explorer",
    "ethereum",
    "multi-chain",
    "cli"
  ],
  "engines": {
    "node": ">=26"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/cli.ts --port 8201 --no-open",
    "mcp": "tsx src/mcp/cli.ts",
    "build": "vite build && tsup",
    "build:client": "vite build",
    "build:server": "tsup",
    "build:pages": "VITE_BASE=/my-block-explorer/ vite build",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "evmole": "^0.9.3",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "storage-layout-fetcher": "^0.2.1",
    "undici": "^8.11.2",
    "viem": "^2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@linaria/core": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@native-router/core": "^1.17.0",
    "@native-router/react": "^1.16.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@wyw-in-js/babel-preset": "^2.5.1",
    "@wyw-in-js/vite": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fetch-fun": "^0.15.0",
    "haze-ui": "^1.30.0",
    "jsdom": "^30.1.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-toolroom": "^1.1.1",
    "react-use-control": "^1.6.1",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vite-plugin-haze-ui": "^1.0.1",
    "vitest": "^5.0.2"
  }
}
